[sub_resource type="Resource" id="Inspection_copy_mirror"]
script = ExtResource("2_inspection")
visible = false
display_name = "复制镜"
function_description = "将最近非空地块上的全部对象复制到镜面对称位置。
复制体同步源塔朝向、等级和攻击事件，可继续被复制，且不占据格子。
复制链最多三层；二级镜会按塔类型强化复制体的攻击方式。"

