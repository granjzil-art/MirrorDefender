[sub_resource type="Resource" id="Inspection_reflect_mirror"]
script = ExtResource("2_inspection")
display_name = "反射镜"
function_description = "按入射角等于反射角的规则反射经过生效面的我方投射物，可连续经过多面反射镜。"

[resource]
